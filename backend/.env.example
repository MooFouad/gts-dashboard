# ===========================================
# GTS Dashboard Backend - Environment Variables
# ===========================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=production

# Frontend URL(s) - separate multiple URLs with commas
# For Production: Add your Vercel frontend URL
ALLOWED_ORIGINS=https://your-frontend-url.vercel.app

# Disable rate limiting for testing/development (set to false in production for security)
# Set to true to disable login attempt limits and API rate limits
DISABLE_RATE_LIMIT=true

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate a strong random secret: https://www.grc.com/passwords.htm
JWT_SECRET=your-super-secret-jwt-key-here-change-this
JWT_EXPIRES_IN=7d

# ===========================================
# PUSH NOTIFICATIONS (VAPID)
# ===========================================
# Generate VAPID keys: npx web-push generate-vapid-keys
# IMPORTANT: Use the SAME keys on both frontend and backend
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:your-email@example.com

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================

# Option 1: Gmail SMTP (Recommended for small deployments)
# Generate App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# Option 2: Brevo SMTP (Recommended for production - 300 emails/day free)
# Get SMTP key from: https://app.brevo.com/settings/keys/smtp
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@brevo.com
# EMAIL_PASS=your-brevo-smtp-key
# EMAIL_FROM=your-email@brevo.com

# ===========================================
# APP CONFIGURATION
# ===========================================
# Frontend URL for email links
APP_URL=https://your-frontend-url.vercel.app

# Notification settings
NOTIFICATION_DAYS_BEFORE=10
NOTIFICATION_CHECK_HOUR=9

# ===========================================
# ABSHER/TAMM API INTEGRATION
# ===========================================
# Production URLs
TAMM_API_URL=https://api.elm.sa
TAMM_AUTH_URL=https://idp.elm.sa/auth/realms/Tamm/protocol/openid-connect/token
TAMM_REALM_NAME=Tamm

# Your Absher API Credentials from Developer Portal
TAMM_CLIENT_ID=your-client-id
TAMM_CLIENT_SECRET=your-client-secret
TAMM_CUSTOMER_ID=your-customer-id
TAMM_SUBSCRIPTION_KEY=

# QA/Testing Environment (uncomment to use)
# TAMM_API_URL=https://tamm-qa-api.apps.devocp4.elm.sa
# TAMM_AUTH_URL=https://idp.apps.devocp4.elm.sa/auth/realms/Tamm-QA/protocol/openid-connect/token
# TAMM_REALM_NAME=Tamm-QA

# ===========================================
# GOSI SOCIAL INSURANCE API INTEGRATION
# ===========================================
# GOSI API for Social Insurance (Engagement Deduction)
# Get credentials from: hrms_support@gosi.gov.sa

# Environment URLs
# Production: https://api.gosi.gov.sa
# Sandbox: https://sandbox-api.gosi.gov.sa
GOSI_BASE_URL=https://sandbox-api.gosi.gov.sa

# API Key (same for sandbox and production)
GOSI_API_KEY=L6LK4GEAAIVrQbVo4AOVrQk781kvIT3X

# Your GOSI Credentials
GOSI_REGISTRATION_NUMBER=your-establishment-registration-number
GOSI_CLIENT_ID=your-client-id
GOSI_CLIENT_SECRET=your-client-secret

# Private Key for DPoP Token Generation (RSA Private Key)
# IMPORTANT: Store on a single line with \n for newlines
# Example format:
GOSI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvwIBAD...(your key here)...\n-----END PRIVATE KEY-----
