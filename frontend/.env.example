# ===========================================
# GTS Dashboard Frontend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values

# Backend API URL
# For Local Development: http://localhost:5000/api
# For Production on Vercel: https://your-backend-api.onrender.com/api
VITE_API_URL=https://your-backend-api.onrender.com/api

# Application Info
VITE_APP_NAME=GTS Dashboard
VITE_APP_VERSION=1.0.0

# Push Notifications - VAPID Public Key
# IMPORTANT: MUST match backend VAPID_PUBLIC_KEY exactly
# Get this from your backend .env file
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# API Usage Flag
VITE_USE_API=true
